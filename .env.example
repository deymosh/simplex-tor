# Mandatory
ADDR_SMP=your_ip_or_addr

ADDR_XFTP=your_ip_or_addr
QUOTA=10gb

# Chat relay display name (shown to channel members who use your relay)
RELAY_NAME=My Tor Relay
# RELAY_SMP_SERVER (smp://<fingerprint>@<onion>) is managed automatically
# by ./simplex once the SMP fingerprint exists - no need to set it manually.
#RELAY_SMP_SERVER=

# Optional
#PASS='123123'
WEB_MANUAL=1